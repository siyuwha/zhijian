# ==============================================================================
# AI 认知复盘交易系统 - NAS Docker 运行环境变量配置
# ==============================================================================

# 前端对外映射端口（若 3000 被占用，可改为 3001、3080 等）
FRONTEND_PORT=3000

# 后端 API 对外映射端口（若 8000 被占用，可改为 8001、8080 等）
BACKEND_PORT=8000

# 数据库存储路径（容器内默认持久化至 ./data/trading.db）
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# 系统时区
TZ=Asia/Shanghai

# ==============================================================================
# 大语言模型沙箱驱动配置 (LLM Sandbox Driver)
# 支持 DeepSeek / OpenAI / DashScope (Qwen) 等 OpenAI 兼容接口
# ==============================================================================
# 1. 优先统一配置:
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 2. 或使用提供商专用变量:
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

